# Next.js frontend (issue #24). Copy to .env.local — never commit secrets.
#
# Clerk must be the same instance the FastAPI API verifies (CLERK_ISSUER / JWKS).
# Create an application at https://dashboard.clerk.com/ and paste keys below.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Clerk path overrides (defaults match App Router pages under throughline/web/)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# FastAPI base URL (browser + server components). Not Django.
NEXT_PUBLIC_API_URL=http://localhost:8000
