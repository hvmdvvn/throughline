# Copy to `.env` for local overrides (`.env` is gitignored).
# Compose also ships safe local defaults when these are unset.
# Never commit real secrets — placeholders only in this file.
#
# Modes (ENVIRONMENT):
#   development — default; DATABASE_URL / REDIS_URL may use documented local defaults
#   production  — app refuses to boot unless DATABASE_URL and REDIS_URL are set

# Runtime mode: development | production
ENVIRONMENT=development

# Postgres bootstrap (Compose `db` service)
POSTGRES_USER=throughline
POSTGRES_PASSWORD=throughline
POSTGRES_DB=throughline
# Optional host publish (uncomment ports in docker-compose.yml to use)
# POSTGRES_PORT=5432

# Redis
# REDIS_PORT=6379

# App — required in production; development may omit and use localhost defaults
# Under Compose, use Docker service hostnames (`db`, `redis`):
DATABASE_URL=postgresql://throughline:throughline@db:5432/throughline
REDIS_URL=redis://redis:6379/0

APP_NAME=Throughline
DEBUG=true
API_PORT=8000

# --- Auth: Clerk (issue #8) — chosen over WorkOS; do not build custom auth ---
# JWT verification via JWKS. Local User + Membership are created on first
# authenticated API request (no separate login endpoint).
#
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Optional JWKS URL override (default: {CLERK_ISSUER}/.well-known/jwks.json)
# CLERK_JWKS_URL=
# Optional audience (leave unset to skip aud verification for session tokens)
# CLERK_AUDIENCE=
# Static JWKS JSON for tests / offline only — never commit real production JWKS
# CLERK_JWKS_STATIC_JSON=
# Single-dev-org bootstrap: first login joins this org as admin (UUID).
# When unset in development, get-or-create org named CLERK_BOOTSTRAP_ORG_NAME.
# CLERK_BOOTSTRAP_ORG_ID=
# CLERK_BOOTSTRAP_ORG_NAME=Dev Org
# Optional Clerk Backend API key (not used for JWT verification)
# CLERK_SECRET_KEY=

# LLM provider stubs (later) — optional; do not put real keys in git
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
